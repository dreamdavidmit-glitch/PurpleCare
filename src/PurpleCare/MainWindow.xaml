<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="紫芯 · 电脑助手" Width="1220" Height="860" MinWidth="760" MinHeight="440" WindowStartupLocation="CenterScreen"
 Background="#090F20" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#EDF2FC" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#FFD12E"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="17,11"/><Setter Property="Background" Value="#FFD12E"/><Setter Property="Foreground" Value="#0A1225"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="body" CornerRadius="5" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="body" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="body" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="body" Property="BorderBrush" Value="#FFDA50"/><Setter TargetName="body" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#1C2B49"/><Setter Property="Foreground" Value="#D8E5FF"/></Style>
  <Style x:Key="Nav" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#A8B9D4"/><Setter Property="Padding" Value="17,14"/><Setter Property="Margin" Value="0,3"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="b" CornerRadius="9" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#203452"/><Setter TargetName="b" Property="BorderBrush" Value="#F12F45"/><Setter TargetName="b" Property="BorderThickness" Value="3,0,0,0"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#172943"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#FFD12E"/><Setter TargetName="b" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#DF101D34"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/><Setter Property="BorderBrush" Value="#263651"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="H2" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#A5B5CD"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="23"/></Style>
  <Style TargetType="ComboBox">
   <Setter Property="MinHeight" Value="38"/><Setter Property="Foreground" Value="#EDF2FC"/><Setter Property="Background" Value="#0C172B"/><Setter Property="BorderBrush" Value="#344764"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,8,0,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="cb" Background="#0C172B" BorderBrush="#344764" BorderThickness="1" CornerRadius="5"><Path Data="M 0 0 L 5 5 L 10 0" Stroke="#FFD12E" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="cb" Property="BorderBrush" Value="#FFD12E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter IsHitTestVisible="False" Margin="12,9,36,9" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" VerticalAlignment="Center"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#142039" BorderBrush="#405777" BorderThickness="1" CornerRadius="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EDF2FC"/><Setter Property="Padding" Value="12,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="item" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="item" Property="Background" Value="#294266"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#FFD12E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DDE8FB"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="#EDF2FC"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#294568"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="9"/><Setter Property="Background" Value="#0B1426"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#385071" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="9"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#EDF2FC"/><Setter Property="CaretBrush" Value="#FFD12E"/><Setter Property="SelectionBrush" Value="#45659A"/><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#344764"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#142039"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Foreground" Value="#EDF2FC"/><Setter Property="RowBackground" Value="#142039"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#24334D"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="40"/><Setter Property="AlternatingRowBackground" Value="#111E35"/><Setter Property="Background" Value="#142039"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1C2B45"/><Setter Property="Foreground" Value="#AFC0DA"/><Setter Property="Padding" Value="10,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
 <ImageBrush x:Key="HeroPhoto" Stretch="UniformToFill" Viewbox="0,0.29,1,0.48" ViewboxUnits="RelativeToBoundingBox" AlignmentY="Center"/></Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Image x:Name="ThemeBackground" Grid.ColumnSpan="2" Stretch="UniformToFill" IsHitTestVisible="False"/>
  <Border Grid.ColumnSpan="2" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EB071020" Offset="0"/><GradientStop Color="#B3091428" Offset="0.45"/><GradientStop Color="#7A091428" Offset="1"/></LinearGradientBrush></Border.Background></Border>
  <Border Background="#E8060C1A">
   <Grid Margin="18,30,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="BrandPanel" Margin="12,0,0,32"><Border x:Name="BrandIcon" Width="44" Height="44" CornerRadius="13" Background="#F12F45" HorizontalAlignment="Left" Margin="0,0,0,14"><TextBlock Text="芯" FontSize="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="紫芯" FontSize="26" Foreground="White" FontWeight="Bold"/><TextBlock Text="电脑助手 · PURPLE CARE" FontSize="10" Foreground="#91A5C5" Margin="0,7,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="工作台" Foreground="#7388A8" FontSize="11" Margin="15,0,0,12"/>
     <RadioButton x:Name="NavHome" Content="概览与体检" GroupName="Nav" Style="{StaticResource Nav}" IsChecked="True"/>
     <RadioButton x:Name="NavGuide" Content="维修引导" GroupName="Nav" Style="{StaticResource Nav}"/><RadioButton x:Name="NavStress" Content="压力测试" GroupName="Nav" Style="{StaticResource Nav}"/>
     <RadioButton x:Name="NavAudio" Content="声音修复" GroupName="Nav" Style="{StaticResource Nav}"/>
     <RadioButton x:Name="NavNetwork" Content="网络修复" GroupName="Nav" Style="{StaticResource Nav}"/>
     <RadioButton x:Name="NavDevices" Content="全部硬件" GroupName="Nav" Style="{StaticResource Nav}"/>
     <RadioButton x:Name="NavBackup" Content="Edge 资料备份" GroupName="Nav" Style="{StaticResource Nav}"/>
     <RadioButton x:Name="NavHistory" Content="历史报告中心" GroupName="Nav" Style="{StaticResource Nav}"/><RadioButton x:Name="NavLogs" Content="操作记录" GroupName="Nav" Style="{StaticResource Nav}"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2"><Border x:Name="SidebarInfo" Background="#111E35" CornerRadius="10" Padding="13"><StackPanel><TextBlock Text="本地运行" Foreground="#D6E4FB" FontWeight="SemiBold"/><TextBlock Text="数据保存在程序所在目录" Foreground="#9AAECC" FontSize="11" Margin="0,7,0,0"/><TextBlock Text="设备操作按需请求管理员权限" Foreground="#9AAECC" FontSize="10" Margin="0,6,0,0"/></StackPanel></Border><TextBlock Text="v1.7.1 · Windows 10 / 11 x64" Foreground="#7F93B1" FontSize="10" Margin="10,18,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="28,24,28,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="PageTitle" Text="概览与体检" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" TextWrapping="Wrap" Text="了解这台电脑，从真实状态开始。" Foreground="#98ACCA" Margin="0,7,0,0"/></StackPanel>
    <WrapPanel x:Name="HeaderActions" Grid.Column="1" VerticalAlignment="Center"><CheckBox x:Name="HideReportIdentity" Content="隐藏账户/电脑名" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="报告仍可能包含 IP、设备标识等信息。"/><Button x:Name="ExportBtn" Content="导出报告" Style="{StaticResource Secondary}" Margin="0,0,10,0"/><Button x:Name="ScanBtn" Content="重新扫描"/></WrapPanel>
   </Grid>
   <Border Grid.Row="1" Background="#12223A" CornerRadius="8" Padding="12,9" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ProgressBar x:Name="BusyBar" Width="40" Height="4" IsIndeterminate="True" Foreground="#FFD12E" Margin="0,0,12,0"/><TextBlock Grid.Column="1" x:Name="StatusText" Text="正在准备扫描…" Foreground="#BED0EA" TextWrapping="Wrap"/></Grid></Border>
   <ScrollViewer x:Name="PageViewport" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><Grid x:Name="PageCanvas" MinWidth="600" MinHeight="420" Width="{Binding ViewportWidth, ElementName=PageViewport}" Height="{Binding ViewportHeight, ElementName=PageViewport}">
    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
     <Border CornerRadius="16" Padding="27" MinHeight="220" Margin="0,0,0,18" Background="{StaticResource HeroPhoto}" BorderBrush="#50617B" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Grid.ColumnSpan="2" Margin="-27" CornerRadius="15" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FA081426" Offset="0"/><GradientStop Color="#D0081426" Offset="0.38"/><GradientStop Color="#30081426" Offset="0.7"/><GradientStop Color="#10081426" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      <StackPanel><TextBlock Text="YOUR COMPUTER" Foreground="#B6C9E2" FontSize="10"/><TextBlock x:Name="ComputerName" Text="正在识别电脑…" FontSize="28" Foreground="White" FontWeight="Bold" Margin="0,8,0,7" TextWrapping="Wrap"/><TextBlock x:Name="ModelName" Text="读取品牌与型号" Foreground="#E0EAF8" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBlock Text="当前用户  " Foreground="#B6C9E2" FontSize="12"/><TextBlock x:Name="UserName" Text="正在读取…" Foreground="White" FontSize="12" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="ScanTime" Text="首次扫描进行中" Foreground="#B6C9E2" FontSize="11" Margin="0,14,0,0"/></StackPanel>
      <Border Grid.Column="1" Background="#66203959" CornerRadius="12" Padding="18" VerticalAlignment="Center" Margin="20,0,0,0"><TextBlock Text="PC" FontSize="34" FontWeight="Light" Foreground="White"/></Border>
     </Grid></Border>
     <UniformGrid Columns="3" Margin="0,0,0,18">
      <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="系统识别设备" Style="{StaticResource Muted}"/><TextBlock x:Name="DeviceCount" Text="—" FontSize="31" Foreground="#FFD12E" Margin="0,8,0,2"/><TextBlock Text="包含系统设备与虚拟设备" FontSize="10" Foreground="#92A5C1"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="设备报告异常" Style="{StaticResource Muted}"/><TextBlock x:Name="IssueCount" Text="—" FontSize="31" Foreground="#FF8E73" Margin="0,8,0,2"/><TextBlock Text="与物理硬件损坏并不等同" FontSize="10" Foreground="#92A5C1"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="可用声音输出" Style="{StaticResource Muted}"/><TextBlock x:Name="AudioCount" Text="—" FontSize="31" Foreground="#FFD12E" Margin="0,8,0,2"/><TextBlock Text="实际有声需要测试确认" FontSize="10" Foreground="#92A5C1"/></StackPanel></Border>
     </UniformGrid><Expander Header="实时监控 · CPU / 内存 / GPU 温度" Foreground="#EDF2FC" Margin="0,0,0,18"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="每 2 秒采样，保留最近 5 分钟；手动开始 / 停止，不运行压力负载。" Style="{StaticResource Muted}"/><WrapPanel Margin="0,12"><Button x:Name="LiveStartBtn" Content="开始监控" Margin="0,0,12,0"/><Button x:Name="LiveStopBtn" Content="停止监控" IsEnabled="False" Style="{StaticResource Secondary}"/></WrapPanel><TextBlock x:Name="LiveStatus" Text="尚未开始监控。" TextWrapping="Wrap"/><UniformGrid Columns="3" Margin="0,16"><StackPanel><TextBlock Text="CPU 使用率"/><TextBlock x:Name="LiveCpu" Text="—" FontSize="23" Foreground="#FFD12E"/></StackPanel><StackPanel><TextBlock Text="内存占用"/><TextBlock x:Name="LiveMemory" Text="—" FontSize="23" Foreground="#6BBBFF"/></StackPanel><StackPanel><TextBlock Text="GPU 最高已读温度"/><TextBlock x:Name="LiveGpu" Text="—" FontSize="23" Foreground="#FFA500"/></StackPanel></UniformGrid><TextBlock Text="黄色 CPU / 蓝色内存 · 系统总占用（%）" Style="{StaticResource Muted}"/><Canvas x:Name="LiveUsageChart" Height="155" ClipToBounds="True"/><TextBlock Text="橙色 GPU 温度（°C）· 多张显卡时显示已读取值中的最高值" Style="{StaticResource Muted}"/><Canvas x:Name="LiveTemperatureChart" Height="150" ClipToBounds="True"/><TextBlock Text="CPU 核心温度未接入；ACPI 温区不会冒充 CPU 温度。未提供的值留空。监控仅展示数据，不会按温度停止压力测试；超过 64 个逻辑处理器时 CPU 统计可能仅覆盖当前处理器组。" Style="{StaticResource Muted}"/></StackPanel></Border></Expander>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="温度传感器" Style="{StaticResource H2}"/><TextBlock x:Name="TemperatureTime" Text="等待读取温度" Style="{StaticResource Muted}"/></StackPanel><Button Grid.Column="1" x:Name="TemperatureScanBtn" Content="管理员读取温度" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
      <ItemsControl x:Name="TemperatureList" Margin="0,12,0,8"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#182941" CornerRadius="8" Padding="14" Margin="0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding Source}" Style="{StaticResource Muted}" Margin="0,4,10,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Display}" Foreground="#FFD12E" FontSize="27" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock x:Name="TemperatureNotes" Style="{StaticResource Muted}"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="耳机拔出后，声音没有回来？" Style="{StaticResource H2}"/><TextBlock Text="检查声音输出，重启音频服务或对应声卡，再播放测试音。" Style="{StaticResource Muted}"/></StackPanel><Button Grid.Column="1" x:Name="HomeAudioBtn" Content="开始声音修复  →" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="硬件与系统信息" Style="{StaticResource H2}"/><ItemsControl x:Name="FactsList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="#99ADC9" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="扫描发现" Style="{StaticResource H2}"/><ItemsControl x:Name="FindingsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#272637" CornerRadius="8" Padding="13" Margin="0,5"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="NoFindings" Text="等待扫描结果" Style="{StaticResource Muted}"/></StackPanel></Border>
     <Border Background="#111D32" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="本次检测范围" FontWeight="SemiBold" Margin="0,0,0,9"/><TextBlock x:Name="LimitationsText" Style="{StaticResource Muted}" Text="设备清单、驱动状态、系统公开的健康数据。未进行压力测试。"/><Button x:Name="AdminScanBtn" Content="管理员补充扫描" HorizontalAlignment="Left" Style="{StaticResource Secondary}" Margin="0,14,0,0"/><TextBlock Text="部分磁盘计数器需要管理员权限；补充扫描仍然只读取数据。" Style="{StaticResource Muted}" Margin="0,9,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="StressPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
     <Border x:Name="StressConfigCard" Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
      <TextBlock Text="设置测试" Style="{StaticResource H2}"/>
      <TextBlock Text="不需要管理员权限。测试 CPU 运算与指定内存区域；请先保存工作，并保持散热通畅。" Style="{StaticResource Muted}"/>
      <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="测试项目" Foreground="#A5B5CD"/><ComboBox x:Name="StressMode"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="时长" Foreground="#A5B5CD"/><ComboBox x:Name="StressDuration"/></StackPanel></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="CPU 负载" Foreground="#A5B5CD"/><ComboBox x:Name="StressLevel"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="测试内存" Foreground="#A5B5CD"/><ComboBox x:Name="StressMemory"/></StackPanel></Grid>
      <WrapPanel><Button x:Name="StressStartBtn" Content="开始压力测试" Margin="0,0,10,0"/><Button x:Name="StressStopBtn" Content="停止测试" Style="{StaticResource Secondary}" IsEnabled="False" Margin="0,0,10,0"/><Button x:Name="StressExportBtn" Content="导出测试结果" Style="{StaticResource Secondary}" IsEnabled="False"/></WrapPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="StressResultIcon" Text="—" FontSize="34" Foreground="#B2C0D6" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock x:Name="StressResultTitle" Text="尚未测试" Style="{StaticResource H2}"/><TextBlock x:Name="StressResultDetail" Text="完成后显示结果图标；中途停止不会显示为测试通过。" Style="{StaticResource Muted}"/></StackPanel></Grid></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="系统 CPU 使用率" Style="{StaticResource Muted}"/><TextBlock x:Name="StressCpuValue" Text="—" FontSize="28" Foreground="#FFD12E"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="系统内存使用率" Style="{StaticResource Muted}"/><TextBlock x:Name="StressMemoryValue" Text="—" FontSize="28" Foreground="#6BBBFF"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="剩余 / 已测试时间" Style="{StaticResource Muted}"/><TextBlock x:Name="StressRemaining" Text="—" FontSize="28"/></StackPanel></Grid>
      <ProgressBar x:Name="StressProgress" Minimum="0" Maximum="100" Height="5" Foreground="#FFD12E" Background="#263651" BorderThickness="0" Margin="0,13,0,10"/>
      <Canvas x:Name="StressChart" Height="170" Background="#A6091428" ClipToBounds="True"/>
      <StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBlock Text="━ CPU" Foreground="#FFD12E" Margin="0,0,22,0"/><TextBlock Text="━ 内存" Foreground="#6BBBFF"/></StackPanel>
      <TextBlock x:Name="StressWork" Text="等待测试开始" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
      <TextBlock x:Name="StressSummary" Text="曲线显示系统使用率，包含其他程序负载；不会将未知数据计为零。" Style="{StaticResource Muted}"/>
     </StackPanel></Border>

     <Border Background="#DF111D32" CornerRadius="12" Padding="18"><TextBlock Text="范围：CPU 固定数据计算校验，以及选定内存区域的写入 / 读取校验。内存按可用空间限额分配；不是全内存检测。未测试 GPU、磁盘、供电或长时间稳定性。&#10;温度页仅提供读取时的快照，测试不能按温度自动停止。一次短测无错误不代表电脑所有硬件完全健康。" Style="{StaticResource Muted}"/></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="AudioPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><Expander Header="最近一次声音修复对照" Foreground="#EDF2FC" Margin="0,0,0,16"><TextBlock x:Name="AudioComparison" Text="尚未执行修复。" TextWrapping="Wrap" Margin="12"/></Expander>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="01  确认输出，播放测试音" Style="{StaticResource H2}"/><TextBlock Text="适用于拔出耳机后扬声器无声、重新插耳机也无声。测试音直接发送到所选输出，不更改音量或默认设备。" Style="{StaticResource Muted}"/><ComboBox x:Name="OutputCombo"/><TextBlock x:Name="OutputDetails" Style="{StaticResource Muted}" Margin="0,0,0,12"/><WrapPanel><Button x:Name="ToneBtn" Content="播放测试音" Margin="0,0,10,0"/><Button x:Name="RefreshAudioBtn" Content="刷新音频状态" Style="{StaticResource Secondary}" Margin="0,0,10,0"/><Button x:Name="SoundSettingsBtn" Content="声音设置" Style="{StaticResource Secondary}"/></WrapPanel><TextBlock x:Name="HearingResult" Text="尚未验证扬声器是否实际发声。" Foreground="#AEC2E0" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="02  恢复音频服务" Style="{StaticResource H2}"/><TextBlock x:Name="AudioServicesText" Text="读取服务状态中…" Style="{StaticResource Muted}"/><TextBlock Text="重新启动 Windows Audio 与 Audio Endpoint Builder。播放和录音会中断，完成后请再次测试声音。" Style="{StaticResource Muted}" Margin="0,8,0,14"/><Button x:Name="RepairAudioBtn" Content="修复音频服务" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="03  重启底层声卡设备" Style="{StaticResource H2}"/><TextBlock Text="服务修复后仍无声时使用。请选择实际声卡；显示器的 HDMI 音频与机身扬声器通常属于不同设备。" Style="{StaticResource Muted}"/><ComboBox x:Name="AudioDeviceCombo"/><TextBlock x:Name="AudioDeviceDetails" Style="{StaticResource Muted}" Margin="0,0,0,12"/><Button x:Name="RestartAudioBtn" Content="重启所选声卡" HorizontalAlignment="Left"/><TextBlock Text="操作成功仅代表 Windows 接受并完成了设备重启，声音是否恢复仍需实际确认。" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="NetworkPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="网络分层诊断" Style="{StaticResource H2}"/><TextBlock Text="检查链路、地址、网关、DNS 和指定网站。点击开始会发送少量网关探测、DNS 查询与 HTTPS HEAD 请求，不携带浏览器 Cookie。使用系统路由，HTTPS 为直连探测，不使用系统 HTTP 代理。" Style="{StaticResource Muted}"/><TextBox x:Name="DiagnosticHost" Text="www.microsoft.com" Margin="0,12" ToolTip="可修改为需要验证的域名，不包含路径或端口。"/><WrapPanel><Button x:Name="NetworkDiagnoseBtn" Content="开始联网诊断" Margin="0,0,10,0"/><Button x:Name="NetworkStopBtn" Content="停止诊断" IsEnabled="False" Style="{StaticResource Secondary}"/></WrapPanel><TextBlock x:Name="NetworkDiagnosticResult" Text="尚未运行主动网络诊断。" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border>
<Expander Header="最近一次网卡修复对照" Foreground="#EDF2FC" Margin="0,0,0,16"><TextBlock x:Name="NetworkComparison" Text="尚未执行修复。" TextWrapping="Wrap" Margin="12"/></Expander>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="重启网络底层设备" Style="{StaticResource H2}"/><TextBlock Text="重新初始化选中的 Wi-Fi、有线或虚拟网卡。保留网络配置，不清除 Wi-Fi 密码，不执行 Winsock 或 TCP/IP 重置。" Style="{StaticResource Muted}"/><ComboBox x:Name="NetworkDeviceCombo"/><TextBlock x:Name="NetworkDeviceDetails" Style="{StaticResource Muted}" Margin="0,0,0,13"/><Border Background="#332A1B" CornerRadius="8" Padding="13" Margin="0,0,0,15"><TextBlock Text="此操作会短暂断网。在线会议、下载和远程连接可能中断；如果正在远程控制这台电脑，请暂缓操作。" Foreground="#FFE099" TextWrapping="Wrap"/></Border><WrapPanel><Button x:Name="RestartNetworkBtn" Content="重启所选网卡" Margin="0,0,10,0"/><Button x:Name="RefreshNetworkBtn" Content="刷新连接状态" Style="{StaticResource Secondary}" Margin="0,0,10,0"/><Button x:Name="NetworkSettingsBtn" Content="网络设置" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="当前网络连接" Style="{StaticResource H2}"/><TextBlock Text="连接状态与本地地址由 Windows 提供；“已连接”不代表互联网一定可用。" Style="{StaticResource Muted}" Margin="0,0,0,12"/><ItemsControl x:Name="NetworksList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#14233C" CornerRadius="9" Padding="16" Margin="0,6"><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,4,0,8"/><WrapPanel><TextBlock Text="状态  " Foreground="#9AAFCE"/><TextBlock Text="{Binding State}" Margin="0,0,20,0"/><TextBlock Text="链路速率  " Foreground="#9AAFCE"/><TextBlock Text="{Binding Speed}"/></WrapPanel><TextBlock Text="{Binding Addresses, StringFormat=IPv4  {0}}" Margin="0,7,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Gateways, StringFormat=网关  {0}}" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Dns, StringFormat=DNS  {0}}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <Grid x:Name="DevicesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" ToolTip="搜索名称、类别、设备 ID 或驱动版本" VerticalContentAlignment="Center"/><ComboBox x:Name="CategoryCombo" Grid.Column="1" Margin="10,0"/><CheckBox x:Name="ProblemsOnly" Grid.Column="2" Content="仅看异常" VerticalAlignment="Center"/></Grid>
     <Border Grid.Row="1" Style="{StaticResource Card}" Padding="5"><DataGrid x:Name="DeviceGrid"><DataGrid.Columns><DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="*" MinWidth="180"/><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="95"/><DataGridTextColumn Header="Windows 状态" Binding="{Binding State}" Width="130"/><DataGridTextColumn Header="驱动版本" Binding="{Binding Driver}" Width="150"/></DataGrid.Columns></DataGrid></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18"><StackPanel><TextBlock x:Name="SelectedDeviceName" Text="选择设备查看详情" FontSize="16" FontWeight="SemiBold"/><TextBox x:Name="SelectedDeviceId" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0,8" TextWrapping="Wrap"/><TextBlock x:Name="SelectedDeviceNote" Style="{StaticResource Muted}" Margin="0,0,0,12"/><WrapPanel><Button x:Name="RestartDeviceBtn" Content="重启选中设备" Margin="0,0,10,0"/><Button x:Name="RescanDevicesBtn" Content="重新检测硬件连接" Style="{StaticResource Secondary}" Margin="0,0,10,0"/><Button x:Name="DeviceManagerBtn" Content="设备管理器" Style="{StaticResource Secondary}" Margin="0,0,10,0"/><Button x:Name="PowerBtn" Content="整机重启选项" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
    </Grid>
    <ScrollViewer x:Name="BackupPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
      <TextBlock Text="备份自己的 Edge 个人资料" Style="{StaticResource H2}"/>
      <TextBlock Text="仅在此页面手动确认后执行。打开程序、扫描硬件和压力测试都不会触发备份。" Style="{StaticResource Muted}" Margin="0,8,0,16"/>
      <TextBlock Text="当前运行账户" Style="{StaticResource Muted}"/><TextBlock x:Name="BackupUser" TextWrapping="Wrap" Margin="0,5,0,14"/>
      <TextBlock Text="备份来源" Style="{StaticResource Muted}"/><TextBlock x:Name="BackupSource" TextWrapping="Wrap" Margin="0,5,0,14"/>
      <TextBlock Text="保存位置 · 自动跟随程序所在盘符" Style="{StaticResource Muted}"/><TextBlock x:Name="BackupDestination" TextWrapping="Wrap" Foreground="#FFD12E" Margin="0,5,0,16"/>
      <TextBlock Text="范围：仅 Default 目录，包含此配置文件内的书签、浏览记录、扩展、缓存、密码数据库、Cookie 和登录会话。不包含其他配置文件及上级目录文件。备份包含敏感个人资料，请妥善保管 U 盘。&#10;&#10;备份前会关闭当前账户、当前会话的 Edge，2 秒后强制结束仍在运行的进程。未保存内容可能丢失，请先保存。备份期间不要重新打开 Edge。&#10;&#10;仅复制文件，不解密、不上传。Default 不是完整的 Edge 迁移备份，跨电脑恢复密码和登录状态不保证可用。每次生成独立目录，不覆盖以前的备份。" Style="{StaticResource Muted}"/>
      <CheckBox x:Name="BackupVerify" IsChecked="True" Margin="0,18,0,0"><TextBlock Text="复制后回读并进行 SHA-256 内容校验（增加读取耗时，可取消勾选）" TextWrapping="Wrap"/></CheckBox><CheckBox x:Name="BackupConsent" Margin="0,20,0,16"><TextBlock Text="这是我的资料；我已保存浏览器中的工作，同意上述备份范围及关闭 Edge。" TextWrapping="Wrap"/></CheckBox>
      <WrapPanel><Button x:Name="BackupStartBtn" Content="备份 Edge…" IsEnabled="False" Margin="0,0,12,0"/><Button x:Name="BackupCancelBtn" Content="停止备份" IsEnabled="False" Style="{StaticResource Secondary}"/></WrapPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="备份进度与结果" Style="{StaticResource H2}"/><ProgressBar x:Name="BackupProgressBar" Minimum="0" Maximum="100" Value="0" Height="12" Foreground="#FFD12E" Background="#263650" Margin="0,14,0,8"/><TextBlock x:Name="BackupPercent" Text="0%" Style="{StaticResource Muted}"/><TextBlock x:Name="BackupStatus" Text="尚未执行备份。" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="GuidePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
<Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="选择要排查的问题" Style="{StaticResource H2}"/><ComboBox x:Name="GuideKind"/><TextBlock Text="引导只提供步骤和入口。是否发声、能否上网等需要你实际确认；它不会自动重启设备、运行压力测试或备份浏览器。" Style="{StaticResource Muted}"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock x:Name="GuideStepTitle" Text="选择问题后开始" Style="{StaticResource H2}"/><TextBlock x:Name="GuideInstruction" TextWrapping="Wrap" Margin="0,10,0,18"/><Button x:Name="GuideGoBtn" Content="前往对应功能" HorizontalAlignment="Left"/><TextBlock Text="操作后回到本页，记录你实际观察到的结果：" Style="{StaticResource Muted}" Margin="0,18,0,5"/><ComboBox x:Name="GuideObservation"/><TextBox x:Name="GuideNote" MaxLength="2000" MinHeight="75" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="可记录现象、时间和已尝试的操作。不要填写密码。"/><WrapPanel Margin="0,16,0,0"><Button x:Name="GuidePrevBtn" Content="上一步" Style="{StaticResource Secondary}" Margin="0,0,12,0"/><Button x:Name="GuideNextBtn" Content="记录后下一步"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="最终反馈与保存" Style="{StaticResource H2}"/><TextBlock Text="任何步骤发现已恢复都可以在这里结束；仍有问题也可以先保存记录。反馈代表用户观察，不是自动健康认证。" Style="{StaticResource Muted}"/><ComboBox x:Name="GuideConclusion"/><TextBlock x:Name="GuideSummary" Text="尚未开始引导。" TextWrapping="Wrap" Margin="0,10,0,12"/><Button x:Name="GuideSaveBtn" Content="保存引导与当前报告到历史中心" HorizontalAlignment="Left"/></StackPanel></Border>
</StackPanel></ScrollViewer>
<Grid x:Name="HistoryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="这里只显示已保存或主动导入的报告。历史结果不会覆盖当前扫描；导入报告可能来自其他电脑。顶部隐藏身份选项同样适用于保存、导入和导出。" Style="{StaticResource Muted}"/><WrapPanel Margin="0,12"><Button x:Name="HistorySaveBtn" Content="保存当前报告" Margin="0,0,10,6"/><Button x:Name="HistoryRefreshBtn" Content="刷新列表" Style="{StaticResource Secondary}" Margin="0,0,10,6"/><Button x:Name="HistoryImportBtn" Content="导入 JSON 报告" Style="{StaticResource Secondary}" Margin="0,0,10,6"/><Button x:Name="HistoryExportBtn" Content="导出选中历史报告" Style="{StaticResource Secondary}" Margin="0,0,0,6"/></WrapPanel><TextBlock x:Name="HistorySummary" Text="点击刷新列表读取本机、本账户的历史报告。" Style="{StaticResource Muted}" Margin="0,0,0,10"/></StackPanel>
<Border Grid.Row="1" Style="{StaticResource Card}" Padding="5"><DataGrid x:Name="HistoryGrid"><DataGrid.Columns><DataGridTextColumn Header="保存时间" Binding="{Binding SavedAt}" Width="150"/><DataGridTextColumn Header="原扫描时间" Binding="{Binding ScanTime}" Width="150"/><DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="*" MinWidth="150"/><DataGridTextColumn Header="来源" Binding="{Binding Origin}" Width="180"/><DataGridTextColumn Header="身份信息" Binding="{Binding Privacy}" Width="95"/></DataGrid.Columns></DataGrid></Border>
<Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="15"><TextBox x:Name="HistoryPreview" Text="选择一条历史报告查看摘要。" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="180" VerticalScrollBarVisibility="Auto"/></Border>
</Grid><Grid x:Name="LogsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="记录操作结果与实际验证；可导出 HTML 或 JSON 报告。" Style="{StaticResource Muted}" Margin="0,0,0,12"/><Expander Header="最近一次修复前后对照" Foreground="#EDF2FC" Margin="0,0,0,12"><ScrollViewer MaxHeight="240"><TextBlock x:Name="LatestComparison" Text="尚未执行修复。" TextWrapping="Wrap" Margin="12"/></ScrollViewer></Expander></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Padding="8"><TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/></Border></Grid>
   </Grid></ScrollViewer>
   <TextBlock Grid.Row="3" x:Name="FooterText" Text="只读扫描 · 修复操作需要主动确认 · 未检测到异常不等于硬件完全健康" Foreground="#8499B9" FontSize="10" Margin="0,15,0,0" TextWrapping="Wrap"/>
  </Grid>
 </Grid>
</Window>
